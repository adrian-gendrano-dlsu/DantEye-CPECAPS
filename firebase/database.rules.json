{
  "rules": {
    ".read": false,
    ".write": false,
    "accounts": {
      ".read": "auth != null && root.child('accounts').child(auth.uid).child('role').val() === 'supervisor'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && root.child('accounts').child(auth.uid).child('role').val() === 'supervisor'",
        "role": {
          ".write": "auth != null && (root.child('accounts').child(auth.uid).child('role').val() === 'supervisor' || (auth.uid === $uid && newData.val() === 'supervisor' && !root.child('setup').child('firstSupervisor').exists() && newData.parent().parent().parent().child('setup').child('firstSupervisor').val() === auth.uid))",
          ".validate": "newData.val() === 'driver' || newData.val() === 'supervisor'"
        },
        "email": {
          ".write": "auth != null && (auth.uid === $uid || root.child('accounts').child(auth.uid).child('role').val() === 'supervisor')",
          ".validate": "newData.isString()"
        },
        "name": {
          ".write": "auth != null && (auth.uid === $uid || root.child('accounts').child(auth.uid).child('role').val() === 'supervisor')",
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "requestedRole": {
          ".write": "auth != null && (auth.uid === $uid || root.child('accounts').child(auth.uid).child('role').val() === 'supervisor')",
          ".validate": "newData.val() === 'driver' || newData.val() === 'supervisor'"
        },
        "requestedAt": {
          ".write": "auth != null && (auth.uid === $uid || root.child('accounts').child(auth.uid).child('role').val() === 'supervisor')",
          ".validate": "newData.isString()"
        },
        "requestedAtMs": {
          ".write": "auth != null && (auth.uid === $uid || root.child('accounts').child(auth.uid).child('role').val() === 'supervisor')",
          ".validate": "newData.isNumber()"
        },
        "lastSignIn": {
          ".write": "auth != null && (auth.uid === $uid || root.child('accounts').child(auth.uid).child('role').val() === 'supervisor')",
          ".validate": "newData.isString()"
        },
        "lastSignInMs": {
          ".write": "auth != null && (auth.uid === $uid || root.child('accounts').child(auth.uid).child('role').val() === 'supervisor')",
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "setup": {
      ".read": "auth != null",
      "firstSupervisor": {
        ".write": "auth != null && !data.exists() && newData.val() === auth.uid && newData.parent().parent().child('accounts').child(auth.uid).child('role').val() === 'supervisor'"
      },
      "firstSupervisorEmail": {
        ".write": "auth != null && !root.child('setup').child('firstSupervisor').exists()"
      },
      "created": {
        ".write": "auth != null && !root.child('setup').child('firstSupervisor').exists()"
      }
    },
    "drivers": {
      ".read": "auth != null && root.child('accounts').child(auth.uid).child('role').val() === 'supervisor'",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid && root.child('accounts').child(auth.uid).child('role').val() === 'driver'",
        ".write": "auth != null && auth.uid === $uid && root.child('accounts').child(auth.uid).child('role').val() === 'driver'",
        "alerts": {
          ".indexOn": [
            "timestampMs"
          ]
        }
      }
    },
    "supervisorPhones": {
      "$uid": {
        ".read": false,
        ".write": "auth != null && auth.uid === $uid && root.child('accounts').child(auth.uid).child('role').val() === 'supervisor'"
      }
    }
  }
}
